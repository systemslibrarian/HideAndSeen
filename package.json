{
  "name": "hideandseen",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive teaching exhibits about QR-code steganography and steganalysis",
  "scripts": {
    "build:data": "python3 tools/build_attribution_data.py",
    "build:vendor": "esbuild node_modules/qrcode/lib/browser.js --bundle --minify --global-name=NodeQRCode --outfile=docs/js/vendor/node-qrcode.min.js",
    "test": "npm run test:core && npm run test:python && npm run test:links && npm run test:browser",
    "test:core": "node tools/test-core.js",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:links": "node tools/check-static-links.js",
    "test:browser": "playwright test",
    "test:emit": "node tools/emit.js /tmp/hideandseen && node tools/verify-js.js /tmp/hideandseen"
  },
  "type": "commonjs",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@zxing/library": "^0.21.3",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4"
  }
}
